{
  "name": "@fets/benchmark",
  "version": "0.0.49",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "exit 0",
    "debug": "node --inspect-brk dist/start-server.js",
    "loadtest": "k6 -e GITHUB_PR=$GITHUB_PR -e GITHUB_SHA=$GITHUB_SHA -e GITHUB_TOKEN=$GITHUB_TOKEN run k6.js",
    "pretest": "npm run build",
    "start": "node dist/start-server.js",
    "test": "start-server-and-test start http://127.0.0.1:4000/ping loadtest"
  },
  "dependencies": {
    "fets": "0.8.12",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#e395e90d78af32507f6cb9c11eb412c08f6d6085"
  },
  "devDependencies": {
    "@types/k6": "2.2.1",
    "start-server-and-test": "3.0.12"
  }
}
