{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>the-guild-org/shared-config:renovate"],
  "automerge": true,
  "major": {
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": [
        "!/@changesets/*/",
        "!/typescript/",
        "!/typedoc*/",
        "!/^@theguild//",
        "!/@graphql-inspector/core/",
        "!/next/",
        "!/tailwindcss/",
        "!/husky/",
        "!/@img/sharp-libvips-linux-x64/",
        "!/sharp/",
        "!/@pulumi/*/",
        "!/^@jest//",
        "!/jest/",
        "!/babel-jest/",
        "!/ts-jest/"
      ]
    },
    {
      "groupName": "all pulumi dependencies",
      "groupSlug": "all-pulumi",
      "matchPackageNames": ["/@pulumi/*/"]
    },
    {
      "groupName": "all jest dependencies",
      "groupSlug": "all-jest",
      "matchPackageNames": ["/^@jest//", "/jest/", "/babel-jest/", "/ts-jest/"]
    },
    {
      "groupName": "all sharp dependencies",
      "groupSlug": "all-sharp",
      "matchPackageNames": ["/@img/sharp-libvips-linux-x64/", "/sharp/"]
    }
  ]
}
